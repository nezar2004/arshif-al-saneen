rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function role(name) {
      return verified() && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == name
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.active == true;
    }
    match /roles/{uid} {
      allow get: if verified() && (request.auth.uid == uid || role('owner'));
      allow list: if role('owner');
    }
    match /students/{uid} {
      allow get: if role('owner') || (role('student') && request.auth.uid == uid);
      allow list: if role('owner');
      match /reminders/{id} {
        function own() { return role('student') && request.auth.uid == uid; }
        allow read, delete: if own();
        allow create: if own() && request.resource.data.keys().hasOnly(['title','at','lead'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120 && request.resource.data.at is int
          && request.resource.data.at > request.time.toMillis()
          && request.resource.data.lead in [15,30,60,1440];
      }
      match /study/{exam} {
        function own() { return role('student') && request.auth.uid == uid; }
        allow read, delete: if own();
        allow create, update: if own() && (exam.matches('[a-f0-9-]{36}') || (
            exam.matches('[a-f0-9-]{36}-[0-9]{1,2}') && request.resource.data.keys().hasOnly(['note'])))
          && request.resource.data.keys().hasOnly(['favorite','note','viewedAt'])
          && (!('favorite' in request.resource.data) || request.resource.data.favorite is bool)
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 2000))
          && (!('viewedAt' in request.resource.data) || request.resource.data.viewedAt == request.time
              || (resource != null && 'viewedAt' in resource.data && request.resource.data.viewedAt == resource.data.viewedAt));
      }
    }
    match /subjects/{id} {
      allow read: if resource.data.active == true || role('owner') || role('assistant');
      allow create, update: if role('owner') && request.resource.data.keys().hasOnly(['name','active','section'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120 && request.resource.data.active is bool;
    }
    match /years/{id} {
      allow read: if role('owner') || role('assistant');
      allow create, update: if role('owner') && id.matches('20[0-9]{2}')
        && request.resource.data.keys().hasOnly(['active']) && request.resource.data.active is bool;
    }
    match /examBatches/{id} {
      allow read: if role('owner') || (role('assistant') && resource.data.uploader == request.auth.uid);
    }
  }
}
